{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchworks.ai/schemas/publication-1.0.json",
  "title": "Patchworks publication",
  "type": "object",
  "required": ["schemaVersion", "document", "pages"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "document": {
      "type": "object",
      "required": ["kind", "title", "date", "documentId", "version"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "date": { "type": "string", "minLength": 1 },
        "documentId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "audience": { "type": "string" },
        "confidentiality": { "type": "string" },
        "author": { "type": "string" },
        "contact": { "type": "string" },
        "url": { "type": "string" },
        "footerNote": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layout"],
        "properties": {
          "layout": {
            "enum": ["cover", "section", "content", "columns", "data", "closing"]
          },
          "theme": { "enum": ["light", "dark"] },
          "eyebrow": { "type": "string" },
          "section": { "type": "string" },
          "number": { "type": "string" },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "dek": { "type": "string" },
          "summary": { "type": "string" },
          "accent": { "type": "string" },
          "preparedFor": { "type": "string" },
          "note": { "type": "string" },
          "clientLogo": {
            "type": "object",
            "required": ["src"],
            "properties": {
              "src": { "type": "string", "minLength": 1 },
              "alt": { "type": "string" }
            },
            "additionalProperties": false
          },
          "body": { "type": "string" },
          "cta": { "type": "string" },
          "contact": { "type": "string" },
          "blocks": { "type": "array" },
          "columns": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "array" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
