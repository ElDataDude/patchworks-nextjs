{
  "name": "startup-nextjs-template",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "test:contact": "node scripts/test-contact.cjs",
    "test:booking": "node design/evidence/test-booking.cjs",
    "test:content": "node scripts/verify-enterprise-content.mjs",
    "cf:build": "node scripts/build-cloudflare.mjs preview",
    "cf:build:production": "node scripts/build-cloudflare.mjs production",
    "cf:preview": "wrangler dev",
    "cf:deploy:preview": "npm run cf:build && wrangler deploy",
    "cf:deploy:production": "npm run cf:build:production && wrangler deploy --env production",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --strict-vars false cloudflare-env.d.ts",
    "test:seo": "node scripts/verify-seo.mjs",
    "typecheck": "tsc --noEmit",
    "test:worker": "node scripts/test-worker.cjs",
    "test:catalogue": "node --test scripts/test-catalogue.cjs",
    "test:session": "node --test scripts/test-session-apps.cjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "lucide-react": "^0.514.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^20.8.9",
    "@types/react": "19.3.0",
    "autoprefixer": "^10.4.17",
    "blake3-wasm": "^2.1.5",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "wrangler": "^4.151.3"
  }
}
